export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // === 配置 ===
    const API_URL = "https://kp-open.keytop.cn/unite-api/api/wec/";
    const FIND_API_URL = "https://kp-open.keytop.cn/unite-api/api/find/"; // 预约车接口走这个前缀
    const APP_ID = "";
    const APP_SECRET = "";
    const PARK_ID = "1208";

    // MD5工具
    async function md5(str) {
      const data = new TextEncoder().encode(str);
      const digest = await crypto.subtle.digest("MD5", data);
      return Array.from(new Uint8Array(digest))
        .map(b => b.toString(16).padStart(2, "0"))
        .join("")
        .toUpperCase();
    }

    // 生成签名
    // 注意：cardInfo/carLotList/plateNoInfo 等字段按科拓协议要求，必须以"已被JSON.stringify过的字符串"形式
    // 参与请求体与签名计算，而不是嵌套对象，否则签名会跟服务端计算不一致。
    async function genSign(params) {
      const filtered = Object.keys(params)
        .filter(k => params[k] !== null && params[k] !== "" && params[k] !== undefined && k !== "appId" && k !== "appSecret")
        .sort()
        .map(k => `${k}=${params[k]}`)
        .join("&");
      return await md5(filtered + "&" + APP_SECRET);
    }

    // 获取北京时间 yyyy-MM-dd HH:mm:ss
    function getBeijingTime() {
      const now = new Date();
      const utc = now.getTime() + now.getTimezoneOffset() * 60000;
      const bj = new Date(utc + 8 * 3600 * 1000);
      return bj.toISOString().replace("T", " ").substring(0, 19);
    }

    // 通用：调用科拓下行接口。base 默认走 /api/wec/，预约车系列走 /api/find/
    async function callKeytop(endpoint, params, base = API_URL) {
      params.key = await genSign(params);
      const res = await fetch(base + endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", version: "1.0.0" },
        body: JSON.stringify(params)
      });
      return await res.text();
    }

    function jsonResponse(txt) {
      return new Response(txt, { headers: { "Content-Type": "application/json;charset=utf-8" } });
    }

    function errorResponse(err) {
      return jsonResponse(JSON.stringify({ resCode: "-1", resMsg: "Worker内部错误", err: String(err) }));
    }

    // === API：查询欠费 ===
    if (url.pathname.endsWith("/api/query") && request.method === "POST") {
      try {
        const { plateNo } = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "getParkingPaymentInfo",
          ts,
          reqId,
          plateNo,
          freeTime: "0",
          freeMoney: "0"
        };

        const txt = await callKeytop("GetParkingPaymentInfo", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：缴费 ===
    if (url.pathname.endsWith("/api/pay") && request.method === "POST") {
      try {
        const { orderNo, payableAmount } = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;
        const payTime = getBeijingTime();

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "payParkingFee",
          ts,
          reqId,
          orderNo,
          payableAmount: payableAmount.toString(),
          payTime,
          amount: payableAmount.toString(),
          payType: "1010",
          payMethod: "1004",
          freeMoney: "0",
          freeTime: "0",
          isNoSense: "0"
        };

        const txt = await callKeytop("PayParkingFee", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：固定车新增（2.2.1 AddCarCardNo）===
    if (url.pathname.endsWith("/api/card/add") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "addCarCardNo",
          ts,
          reqId,
          userId: body.userId ?? "0",
          userName: body.userName ?? "",
          cardInfo: JSON.stringify(body.cardInfo || {}),
          carLotList: JSON.stringify(body.carLotList || []),
          plateNoInfo: JSON.stringify(body.plateNoInfo || [])
        };

        const txt = await callKeytop("AddCarCardNo", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：固定车查询（2.2.2 GetCarCardInfo）===
    if (url.pathname.endsWith("/api/card/query") && request.method === "POST") {
      try {
        const { plateNo, cardId, cardNo, state, carType, isFullPlateNo } = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "getCarCardInfo",
          ts,
          reqId,
          plateNo,
          cardId,
          cardNo,
          state,
          carType,
          isFullPlateNo
        };

        const txt = await callKeytop("GetCarCardInfo", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：固定车修改（2.2.3 ModifyCarCardNo）===
    if (url.pathname.endsWith("/api/card/modify") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "modifyCarCardNo",
          ts,
          reqId,
          userId: body.userId ?? "0",
          userName: body.userName ?? "",
          cardInfo: JSON.stringify(body.cardInfo || {}),
          carLotList: JSON.stringify(body.carLotList || []),
          plateNoInfo: JSON.stringify(body.plateNoInfo || [])
        };

        const txt = await callKeytop("ModifyCarCardNo", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：固定车充值（2.2.6 PayCarCardFee）===
    if (url.pathname.endsWith("/api/card/recharge") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;
        const createTime = getBeijingTime();

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "payCarCardFee",
          ts,
          reqId,
          userId: body.userId ?? "0",
          userName: body.userName ?? "",
          cardId: body.cardId,
          orderNo: body.orderNo || ("R" + ts),
          carType: body.carType,
          payChannel: body.payChannel ?? 1,
          chargeMethod: body.chargeMethod,
          chargeNumber: body.chargeNumber,
          amount: body.amount,
          freeNumber: body.freeNumber ?? 0,
          validFrom: body.validFrom,
          validTo: body.validTo,
          createTime,
          remark: body.remark ?? "",
          merchantNo: body.merchantNo,
          ruleId: body.ruleId,
          lotIds: body.lotIds,
          imageUrl: body.imageUrl
        };

        const txt = await callKeytop("PayCarCardFee", params);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：预约车-用户车位预订（2.4.1 ReserveSpace）===
    if (url.pathname.endsWith("/api/reserve/add") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "reserveSpace",
          ts,
          reqId,
          plateNo: body.plateNo,
          cardNo: body.cardNo,
          type: body.type ?? "1", // 0:车位 1:区域
          addrId: body.addrId,
          enterTime: body.enterTime,
          leaveTime: body.leaveTime,
          userName: body.userName,
          tel: body.tel,
          failureTime: body.failureTime,
          flag: body.flag ?? "1", // 0只允许进出一次 1允许多次进出场
          flag2: body.flag2,
          merchantName: body.merchantName,
          remark: body.remark,
          cardType: body.cardType ?? 100, // 默认100标准预约车，6x必填
          bookingAmount: body.bookingAmount,
          payMethod: body.payMethod,
          bookingType: body.bookingType
        };

        const txt = await callKeytop("ReserveSpace", params, FIND_API_URL);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：预约车-修改预约车有效期（2.4.2 ReserveSpace_ChangeTime）===
    if (url.pathname.endsWith("/api/reserve/modify") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "reserveSpace_ChangeTime",
          ts,
          reqId,
          OrderNo: body.orderNo,
          enterTime: body.enterTime,
          leaveTime: body.leaveTime,
          failureTime: body.failureTime,
          flag: body.flag
        };

        const txt = await callKeytop("ReserveSpace_ChangeTime", params, FIND_API_URL);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：预约车-车位预订取消（2.4.3 CancelReserveSpace）===
    if (url.pathname.endsWith("/api/reserve/cancel") && request.method === "POST") {
      try {
        const { orderNo } = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "cancelReserveSpace",
          ts,
          reqId,
          orderNo
        };

        const txt = await callKeytop("CancelReserveSpace", params, FIND_API_URL);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：预约车-预订车位查询（2.4.4 GetReservableInfo）===
    if (url.pathname.endsWith("/api/reserve/available") && request.method === "POST") {
      try {
        const { enterTime, leaveTime } = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "getReservableInfo",
          ts,
          reqId,
          enterTime,
          leaveTime
        };

        const txt = await callKeytop("GetReservableInfo", params, FIND_API_URL);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === API：预约车-查询预约记录列表（2.4.5 PageReserveSpace，仅6x）===
    if (url.pathname.endsWith("/api/reserve/list") && request.method === "POST") {
      try {
        const body = await request.json();
        const ts = Date.now().toString();
        const reqId = ts;

        let params = {
          appId: APP_ID,
          parkId: PARK_ID,
          serviceCode: "pageReserveSpace",
          ts,
          reqId,
          fullCarNo: body.fullCarNo,
          fullCardNo: body.fullCardNo,
          startTime: body.startTime,
          endTime: body.endTime,
          pageIndex: body.pageIndex ?? 1,
          pageSize: body.pageSize ?? 20,
          status: body.status
        };

        const txt = await callKeytop("pageReserveSpace", params, FIND_API_URL);
        return jsonResponse(txt);
      } catch (err) {
        return errorResponse(err);
      }
    }

    // === 默认页面 ===
    return new Response(PAGE_HTML, { headers: { "Content-Type": "text/html;charset=utf-8" } });
  }
}

