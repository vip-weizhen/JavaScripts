<script>
  function isJson(str){ try { JSON.parse(str); return true; } catch { return false; } }

  // 把 <input type="datetime-local"> 的值 "2025-01-01T09:00" 转换成接口要求的 "2025-01-01 09:00:00"
  function dt(id){
    const v = document.getElementById(id).value;
    if(!v) return undefined;
    return v.replace('T', ' ') + ':00';
  }

  // 取输入框的值，空字符串一律转成 undefined，方便 JSON.stringify 时自动省略该字段
  function val(id){
    const v = document.getElementById(id).value;
    return v === '' ? undefined : v;
  }
  function numOrUndef(id){
    const v = document.getElementById(id).value;
    return v === '' ? undefined : Number(v);
  }
  // 逗号分隔的字符串转成数组，空值返回 undefined
  function csvArr(id){
    const v = document.getElementById(id).value;
    if(v === '') return undefined;
    return v.split(',').map(s => s.trim()).filter(Boolean);
  }

  function showGroup(group, btn){
    document.querySelectorAll('.group-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('nav-card').style.display = group === 'card' ? 'flex' : 'none';
    document.getElementById('nav-reserve').style.display = group === 'reserve' ? 'flex' : 'none';
    const firstPanel = group === 'card' ? 'cardQuery' : 'reserveAvailable';
    const firstNav = document.getElementById('nav-' + group);
    showPanel(firstPanel, firstNav.querySelector('.sub-btn'));
  }

  function showPanel(id, btn){
    document.querySelectorAll('.card').forEach(p => p.classList.remove('active'));
    const parentNav = btn.parentElement;
    parentNav.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
  }

  // ===== 结果美化相关工具函数 =====
  function esc(v){
    if(v === undefined || v === null) return '';
    return String(v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // 键值表格：rows 形如 [['标签', 值], ...]，值为空自动跳过
  function kv(rows){
    const filtered = rows.filter(r => r[1] !== undefined && r[1] !== null && r[1] !== '');
    if(!filtered.length) return '';
    return '<table class="info">' + filtered.map(r =>
      '<tr><td>' + esc(r[0]) + '</td><td>' + r[1] + '</td></tr>'
    ).join('') + '</table>';
  }

  // 列表表格：headers 是表头数组，rows 是二维数组（每行的值数组，已格式化好的HTML片段或文本）
  function listTable(headers, rows){
    if(!rows || !rows.length) return '<div class="empty-hint">暂无数据</div>';
    const thead = '<tr>' + headers.map(h => '<th>' + esc(h) + '</th>').join('') + '</tr>';
    const tbody = rows.map(r => '<tr>' + r.map(c => '<td>' + (c === undefined || c === null || c === '' ? '-' : c) + '</td>').join('') + '</tr>').join('');
    return '<div class="table-scroll"><table class="info list-table"><thead>' + thead + '</thead><tbody>' + tbody + '</tbody></table></div>';
  }

  function sectionTitle(text){ return '<div class="section-title">' + esc(text) + '</div>'; }

  function badge(text, kind){ return '<span class="badge ' + kind + '">' + esc(text) + '</span>'; }

  // 尝试把接口返回的 data 字段（可能是JSON字符串，也可能已是对象）解析成对象
  function parseData(data){
    if(data === undefined || data === null || data === '') return {};
    if(typeof data === 'object') return data;
    try { return JSON.parse(data); } catch(e) { return {}; }
  }

  // 通用分发渲染：resCode !== '0' 时显示错误提示；成功时调用 buildHtml(data, obj) 生成结构化HTML；
  // buildHtml 抛错或未提供时，回退成带缩进的原始JSON展示。
  function renderApiResult(elId, txt, buildHtml){
    const box = document.getElementById(elId);
    if(!isJson(txt)){
      box.innerHTML = '<div class="raw err">' + esc(txt) + '</div>';
      return;
    }
    const obj = JSON.parse(txt);
    if(obj.resCode !== '0'){
      box.innerHTML = '<div class="status-msg err">' + esc(obj.resMsg || '请求失败') + '</div>';
      return;
    }
    const data = parseData(obj.data);
    try {
      const html = buildHtml ? buildHtml(data, obj) : '';
      box.innerHTML = html || '<div class="status-msg ok">✅ 操作成功</div>';
    } catch(e){
      box.innerHTML = '<div class="raw">' + esc(JSON.stringify(obj, null, 2)) + '</div>';
    }
  }

  // 常用枚举文案
  const CARD_STATE_MAP = {0:'未审核', 1:'审核通过', 2:'审核不通过（注销）'};
  const CHECK_MAP = {0:'未审核', 1:'已审核'};
  const RESERVE_TYPE_MAP = {0:'车位', 1:'区域'};
  const RESERVE_STATUS_MAP = {0:'已取消', 1:'待生效', 2:'使用中', 3:'已结束', 4:'已失效'};
  const PERMIT_TIMES_MAP = {0:'可多次进出', 1:'只能一次进出'};
  const BOOKING_TYPE_MAP = {0:'车位预约', 1:'预约区域'};

  function reserveStatusBadge(status){
    const text = RESERVE_STATUS_MAP[status] ?? ('状态' + status);
    const kindMap = {0:'mut', 1:'warn', 2:'ok', 3:'mut', 4:'err'};
    return badge(text, kindMap[status] || 'mut');
  }

  async function postJson(path, body){
    const res = await fetch(path, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(body)
    });
    return await res.text();
  }

  // === 临停查询/缴费 ===
  let lastOrderNo = null, lastPayable = 0;
  const payBtn = document.getElementById('payBtn');

  async function query(){
    const plate = document.getElementById('plate').value;
    const txt = await postJson('./api/query', {plateNo: plate});
    const box = document.getElementById('result');

    if(isJson(txt)){
      const obj = JSON.parse(txt);
      if(obj.resCode === '0' && obj.data){
        const data = JSON.parse(obj.data);
        lastOrderNo = data.orderNo;
        lastPayable = data.payable;
        payBtn.disabled = lastPayable <= 0;
        box.innerHTML = '<table class="info">' +
            '<tr><td>车场ID</td><td>' + data.parkId + '</td></tr>' +
            '<tr><td>账单号</td><td>' + data.orderNo + '</td></tr>' +
            '<tr><td>车牌号</td><td>' + data.plateNo + '</td></tr>' +
            '<tr><td>卡号/票号</td><td>' + (data.cardNo || '-') + '</td></tr>' +
            '<tr><td>车场名称</td><td>' + data.parkName + '</td></tr>' +
            '<tr><td>入场时间</td><td>' + data.entryTime + '</td></tr>' +
            '<tr><td>停车时长</td><td>' + data.elapsedTime + ' 分钟</td></tr>' +
            '<tr><td>停车总金额</td><td>' + data.totalAmount + ' 分</td></tr>' +
            '<tr><td>应缴金额</td><td>' + data.payable + ' 分</td></tr>' +
          '</table>';
      } else {
        box.innerHTML = '<div class="status-msg err">未找到车辆信息</div>';
        payBtn.disabled = true;
      }
    } else {
      box.innerHTML = '<div class="status-msg err">接口返回异常：' + txt + '</div>';
      payBtn.disabled = true;
    }
  }

  async function pay(){
    if(!lastOrderNo || lastPayable <= 0){ alert('没有可缴费用'); return; }
    const txt = await postJson('./api/pay', {orderNo: lastOrderNo, payableAmount: lastPayable});
    const box = document.getElementById('result');
    if(isJson(txt)){
      const obj = JSON.parse(txt);
      if(obj.resCode === '0'){
        box.innerHTML += '<div class="status-msg ok">✅ 缴费完成</div>';
        payBtn.disabled = true;
      } else {
        box.innerHTML += '<div class="status-msg err">缴费失败：' + obj.resMsg + '</div>';
      }
    } else {
      box.innerHTML += '<div class="status-msg err">缴费返回异常：' + txt + '</div>';
    }
  }

  // === 固定车 ===
  async function cardQuery(){
    const body = {
      plateNo: document.getElementById('cq_plateNo').value || undefined,
      cardId: document.getElementById('cq_cardId').value || undefined,
      cardNo: document.getElementById('cq_cardNo').value || undefined
    };
    renderApiResult('res_cardQuery', await postJson('./api/card/query', body), buildCardQueryHtml);
  }

  function buildCardQueryHtml(data){
    if(!data || Object.keys(data).length === 0) return '<div class="status-msg err">未找到固定车信息</div>';
    let html = '';
    html += kv([
      ['卡片id', data.cardId],
      ['卡片名称', data.cardName],
      ['户主名', data.useName],
      ['手机号', data.tel],
      ['邮箱', data.email],
      ['房间号', data.roomId],
      ['联系地址', data.contact],
      ['商户id', data.merchantId],
      ['车牌合集', data.fullCarNoStr],
      ['车位数量', data.lotCount],
      ['未过期车位', data.validCount],
      ['状态', data.cardState !== undefined ? (CARD_STATE_MAP[data.cardState] ?? data.cardState) : undefined],
      ['首充时间', data.effectiveTime],
      ['最后更新', data.lastUpdateTime],
      ['备注', data.remak]
    ]);

    if(Array.isArray(data.plateNoInfo) && data.plateNoInfo.length){
      html += sectionTitle('车牌信息');
      html += listTable(
        ['车牌id', '车牌号', 'ETC号/卡号', '状态', '车辆类型', '车牌颜色', '车身颜色', '品牌', '备注'],
        data.plateNoInfo.map(p => [
          esc(p.id),
          esc(p.plateNo),
          esc(p.etcNo),
          p.plateState === 2 ? badge('禁用', 'err') : badge('启用', 'ok'),
          esc(p.carStyle),
          esc(p.carNoColor),
          esc(p.carColor),
          esc(p.carBrand),
          esc(p.remark)
        ])
      );
    }

    if(Array.isArray(data.carLotList) && data.carLotList.length){
      html += sectionTitle('车位信息');
      html += listTable(
        ['车位id', '车位备注', '套餐', '区域', '有效期开始', '有效期结束', '车位数', '余额/次数', '产权车位', '充值规则id'],
        data.carLotList.map(l => [
          esc(l.id),
          esc(l.lotName),
          esc(l.carTypeName ?? l.carType),
          esc(l.areaName),
          esc(l.beginTime),
          esc(l.endTime),
          esc(l.lotCount),
          esc(l.validValue),
          l.propertyLot === 1 ? badge('是', 'warn') : badge('否', 'mut'),
          esc(l.ruleId)
        ])
      );
    }

    return html;
  }

  async function cardAdd(){
    const cardInfo = {
      useName: val('ca_useName'),
      tel: val('ca_tel'),
      cardName: val('ca_cardName'),
      email: val('ca_email'),
      roomId: val('ca_roomId'),
      merchantId: val('ca_merchantId'),
      contact: val('ca_contact'),
      assist: val('ca_assist'),
      effectiveTime: val('ca_effectiveTime'),
      imageUrl: val('ca_imageUrl'),
      remak: val('ca_remak')
    };
    const carLot = {
      areaId: csvArr('ca_areaId') || [],
      carType: Number(document.getElementById('ca_carType').value),
      lotCount: Number(document.getElementById('ca_lotCount').value),
      lotName: val('ca_lotName'),
      sequence: numOrUndef('ca_sequence'),
      ruleId: numOrUndef('ca_ruleId'),
      spaceId: csvArr('ca_spaceId'),
      effectiveTime: val('ca_lotEffectiveTime'),
      propertyLot: numOrUndef('ca_propertyLot')
    };
    const plate = {
      plateNo: val('ca_plateNo'),
      etcNo: val('ca_etcNo'),
      carStyle: numOrUndef('ca_carStyle'),
      carNoColor: val('ca_carNoColor'),
      carColor: val('ca_carColor'),
      carBrand: val('ca_carBrand'),
      plateState: numOrUndef('ca_plateState'),
      remark: val('ca_plateRemark')
    };
    const body = {
      userId: document.getElementById('ca_userId').value,
      userName: document.getElementById('ca_userName').value,
      cardInfo,
      carLotList: [carLot],
      plateNoInfo: [plate]
    };
    renderApiResult('res_cardAdd', await postJson('./api/card/add', body), data => {
      if(data.cardId === undefined) return '<div class="status-msg ok">✅ 提交成功</div>';
      return kv([
        ['新增卡片id', data.cardId],
        ['审核状态', data.ischeck !== undefined ? (CHECK_MAP[data.ischeck] ?? data.ischeck) : undefined]
      ]) || '<div class="status-msg ok">✅ 新增成功</div>';
    });
  }

  async function cardModify(){
    const cardInfo = {
      cardId: document.getElementById('cm_cardId').value,
      useName: val('cm_useName'),
      tel: val('cm_tel'),
      cardName: val('cm_cardName'),
      email: val('cm_email'),
      roomId: val('cm_roomId'),
      merchantId: val('cm_merchantId'),
      contact: val('cm_contact'),
      assist: val('cm_assist'),
      effectiveTime: val('cm_effectiveTime'),
      imageUrl: val('cm_imageUrl'),
      remak: val('cm_remak')
    };

    // 车位信息：只要填了其中任意一项才组装这条记录。
    // id留空=新增；id+其他字段=更新；只填id=删除该车位。
    const carLotList = [];
    const lotId = val('cm_lotId'), lotName = val('cm_lotName'), lotCarType = val('cm_lotCarType'),
          areaName = val('cm_areaName'), areaIdRaw = val('cm_areaId'), lotCount = val('cm_lotCount'),
          ruleId = val('cm_ruleId'), spaceId = val('cm_spaceId'), propertyLot = val('cm_propertyLot'),
          lotEffectiveTime = val('cm_lotEffectiveTime'), sequence = val('cm_sequence');
    if(lotId || lotName || lotCarType || areaName || areaIdRaw || lotCount || ruleId || spaceId || lotEffectiveTime || sequence){
      carLotList.push({
        id: lotId,
        lotName,
        carType: lotCarType !== undefined ? Number(lotCarType) : undefined,
        sequence: sequence !== undefined ? Number(sequence) : undefined,
        areaName,
        areaId: csvArr('cm_areaId'),
        lotCount: lotCount !== undefined ? Number(lotCount) : undefined,
        ruleId: ruleId !== undefined ? Number(ruleId) : undefined,
        spaceId: csvArr('cm_spaceId'),
        effectiveTime: lotEffectiveTime,
        propertyLot: propertyLot !== undefined ? Number(propertyLot) : undefined
      });
    }

    // 车牌信息：同理，id留空=新增；id+其他字段=更新；只填id=删除该车牌。
    const plateNoInfo = [];
    const plateId = val('cm_plateId'), plateNo = val('cm_plateNo'), etcNo = val('cm_etcNo'),
          plateState = val('cm_plateState'), carStyle = val('cm_carStyle'), carNoColor = val('cm_carNoColor'),
          carColor = val('cm_carColor'), carBrand = val('cm_carBrand'), plateRemark = val('cm_plateRemark');
    if(plateId || plateNo || etcNo){
      plateNoInfo.push({
        id: plateId,
        plateNo,
        etcNo,
        plateState: plateState !== undefined ? Number(plateState) : undefined,
        carStyle: carStyle !== undefined ? Number(carStyle) : undefined,
        carNoColor,
        carColor,
        carBrand,
        remark: plateRemark
      });
    }

    const body = {
      userId: document.getElementById('cm_userId').value,
      userName: document.getElementById('cm_userName').value,
      cardInfo,
      carLotList,
      plateNoInfo
    };
    renderApiResult('res_cardModify', await postJson('./api/card/modify', body), () =>
      '<div class="status-msg ok">✅ 修改成功</div>'
    );
  }

  async function cardRecharge(){
    const body = {
      cardId: document.getElementById('cr_cardId').value,
      carType: Number(document.getElementById('cr_carType').value),
      userId: document.getElementById('cr_userId').value,
      userName: document.getElementById('cr_userName').value,
      chargeMethod: Number(document.getElementById('cr_chargeMethod').value),
      chargeNumber: Number(document.getElementById('cr_chargeNumber').value),
      amount: Number(document.getElementById('cr_amount').value),
      freeNumber: Number(document.getElementById('cr_freeNumber').value),
      validFrom: dt('cr_validFrom'),
      validTo: dt('cr_validTo'),
      payChannel: 1,
      remark: document.getElementById('cr_remark').value || undefined,
      merchantNo: document.getElementById('cr_merchantNo').value || undefined,
      ruleId: document.getElementById('cr_ruleId').value || undefined,
      lotIds: document.getElementById('cr_lotIds').value || undefined,
      imageUrl: document.getElementById('cr_imageUrl').value || undefined
    };
    renderApiResult('res_cardRecharge', await postJson('./api/card/recharge', body), data => {
      const table = kv([
        ['充值订单号', data.orderNo],
        ['审核状态', data.ischeck !== undefined ? (CHECK_MAP[data.ischeck] ?? data.ischeck) : undefined]
      ]);
      return (table ? table : '') + '<div class="status-msg ok">✅ 充值成功</div>';
    });
  }

  // === 预约车 ===
  async function reserveAvailable(){
    const body = {
      enterTime: dt('ra_enterTime'),
      leaveTime: dt('ra_leaveTime')
    };
    renderApiResult('res_reserveAvailable', await postJson('./api/reserve/available', body), data => {
      let html = kv([['总可预订数', data.totalNum]]);
      if(Array.isArray(data.reserveList) && data.reserveList.length){
        html += sectionTitle('可预约车位/区域');
        html += listTable(
          ['名称', '类型', '剩余车位', 'ID'],
          data.reserveList.map(r => [
            esc(r.addrName),
            esc(RESERVE_TYPE_MAP[r.type] ?? r.type),
            r.free > 0 ? badge(r.free + ' 个', 'ok') : badge('0 个', 'mut'),
            esc(r.addrId)
          ])
        );
      } else {
        html += '<div class="empty-hint">暂无可预约车位/区域</div>';
      }
      return html;
    });
  }

  async function reserveAdd(){
    const body = {
      plateNo: document.getElementById('rs_plateNo').value || undefined,
      cardNo: document.getElementById('rs_cardNo').value || undefined,
      type: document.getElementById('rs_type').value,
      addrId: document.getElementById('rs_addrId').value,
      enterTime: dt('rs_enterTime'),
      leaveTime: dt('rs_leaveTime'),
      failureTime: dt('rs_failureTime'),
      flag: document.getElementById('rs_flag').value,
      userName: document.getElementById('rs_userName').value || undefined,
      tel: document.getElementById('rs_tel').value || undefined,
      cardType: Number(document.getElementById('rs_cardType').value),
      remark: document.getElementById('rs_remark').value || undefined,
      flag2: val('rs_flag2'),
      merchantName: val('rs_merchantName'),
      bookingAmount: val('rs_bookingAmount'),
      payMethod: val('rs_payMethod'),
      bookingType: val('rs_bookingType')
    };
    renderApiResult('res_reserveAdd', await postJson('./api/reserve/add', body), data => {
      const table = kv([
        ['预约订单号', data.orderNo],
        ['保留时间（最迟入场）', data.keepTime]
      ]);
      return (table || '<div class="status-msg ok">✅ 预约成功</div>');
    });
  }

  async function reserveModify(){
    const body = {
      orderNo: document.getElementById('rm_orderNo').value,
      enterTime: dt('rm_enterTime'),
      leaveTime: dt('rm_leaveTime'),
      failureTime: dt('rm_failureTime'),
      flag: document.getElementById('rm_flag').value || undefined
    };
    renderApiResult('res_reserveModify', await postJson('./api/reserve/modify', body), () =>
      '<div class="status-msg ok">✅ 有效期修改成功</div>'
    );
  }

  async function reserveCancel(){
    const body = { orderNo: document.getElementById('rc_orderNo').value };
    renderApiResult('res_reserveCancel', await postJson('./api/reserve/cancel', body), () =>
      '<div class="status-msg ok">✅ 预约已取消</div>'
    );
  }

  async function reserveList(){
    const body = {
      fullCarNo: document.getElementById('rl_fullCarNo').value || undefined,
      fullCardNo: document.getElementById('rl_fullCardNo').value || undefined,
      startTime: dt('rl_startTime'),
      endTime: dt('rl_endTime'),
      pageIndex: Number(document.getElementById('rl_pageIndex').value),
      pageSize: Number(document.getElementById('rl_pageSize').value),
      status: document.getElementById('rl_status').value === '' ? undefined : Number(document.getElementById('rl_status').value)
    };
    renderApiResult('res_reserveList', await postJson('./api/reserve/list', body), data => {
      let html = kv([
        ['总记录数', data.totalCount],
        ['当前页', data.pageIndex],
        ['每页数量', data.pageSize]
      ]);
      if(Array.isArray(data.records) && data.records.length){
        html += sectionTitle('预约记录');
        html += listTable(
          ['车牌号/凭据号', '预约进场', '预约出场', '失效时间', '状态', '进出限制', '预约类型', '车位/区域', '创建时间', '来源', '备注'],
          data.records.map(r => [
            esc(r.carNo || r.cardNo),
            esc(r.beginTime),
            esc(r.endTime),
            esc(r.failureTime),
            reserveStatusBadge(r.status),
            esc(PERMIT_TIMES_MAP[r.permitTimes] ?? r.permitTimes),
            esc(BOOKING_TYPE_MAP[r.bookingType] ?? r.bookingType),
            esc(r.addrId || r.lotNo),
            esc(r.createTime),
            esc(r.source),
            esc(r.remarks)
          ])
        );
      } else {
        html += '<div class="empty-hint">暂无预约记录</div>';
      }
      return html;
    });
  }
</script>
</body>
</html>`;
