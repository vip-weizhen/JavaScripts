// 按钮改为禁用+loading，避免重复点击
function setButtonLoading(btn, loading) {
    if (loading) {
        btn.classList.add('loading');
        btn.disabled = true;
    } else {
        btn.classList.remove('loading');
        btn.disabled = false;
    }
}

function notifyOwner() {
    const maxCount = 3;
    const timeLimit = 60 * 1000; // 1分钟

    // 用时间戳判断是否已经过了限制窗口，而不是依赖 setTimeout
    // （setTimeout 在页面关闭/刷新后不会执行，会导致次数卡住无法重置）
    const now = Date.now();
    const windowStart = parseInt(localStorage.getItem('notifyWindowStart') || '0');
    let notifyCount = parseInt(localStorage.getItem('notifyCount') || '0');

    if (now - windowStart > timeLimit) {
        // 距上次窗口开始已超过1分钟，重新计数
        notifyCount = 0;
        localStorage.setItem('notifyWindowStart', now.toString());
    }

    // 检查是否超过次数限制
    if (notifyCount >= maxCount) {
        const waitSeconds = Math.ceil((timeLimit - (now - windowStart)) / 1000);
