const ADMIN_TOKEN = ""; 

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const { pathname } = url;

    // ── 跨域头（可按需修改）──────────────────────────────────
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type, Authorization",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    // ── 鉴权辅助函数 ─────────────────────────────────────────
    function authFail() {
      return new Response(JSON.stringify({ error: "未授权，token 错误" }), {
        status: 401,
        headers: { "Content-Type": "application/json", ...corsHeaders },
      });
    }

    function checkAuth() {
      const auth = request.headers.get("Authorization") || "";
      return auth === `Bearer ${ADMIN_TOKEN}`;
    }

    // ── KV 记录读写辅助函数 ───────────────────────────────────
    // 新格式：value 是 JSON 字符串 {"url": "...", "clicks": 0, "maxClicks": null}
    // 兼容旧格式：value 是纯网址字符串（自动当作 clicks: 0, maxClicks: null）
    // 兼容中间格式：没有 maxClicks 字段的旧 JSON 记录（自动补 null，即不限次数）
    async function getRecord(code) {
      const raw = await env.url.get(code);
      if (raw === null) return null;
      try {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === "object" && typeof parsed.url === "string") {
          return {
            url: parsed.url,
            clicks: Number(parsed.clicks) || 0,
            maxClicks: Number.isFinite(Number(parsed.maxClicks)) && Number(parsed.maxClicks) > 0
              ? Number(parsed.maxClicks)
              : null,
          };
        }
      } catch (e) {
        // 不是 JSON，说明是旧数据（纯网址字符串），走下面的兼容分支
      }
      return { url: raw, clicks: 0, maxClicks: null };
    }

    async function putRecord(code, record) {
      await env.url.put(code, JSON.stringify(record));
    }

    // ── POST /shorten：生成短链 ───────────────────────────────
    if (request.method === "POST" && pathname === "/shorten") {
      const data = await request.json();
      let { url: longUrl, customCode, maxClicks } = data;

      if (!longUrl || !/^https?:\/\//.test(longUrl)) {
        return new Response(JSON.stringify({ error: "请输入合法的网址（需以 http:// 或 https:// 开头）" }), {
          status: 400,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }

      // 校验最大访问次数（可选）
      let parsedMaxClicks = null;
      if (maxClicks !== undefined && maxClicks !== null && maxClicks !== "") {
        const n = Number(maxClicks);
        if (!Number.isInteger(n) || n <= 0) {
          return new Response(JSON.stringify({ error: "最大访问次数必须是大于 0 的整数" }), {
            status: 400,
            headers: { "Content-Type": "application/json", ...corsHeaders },
          });
        }
        parsedMaxClicks = n;
      }

      let shortCode = customCode?.trim() || Math.random().toString(36).substring(2, 8);

      // 校验自定义短码格式
      if (customCode && !/^[a-zA-Z0-9_-]+$/.test(customCode)) {
        return new Response(JSON.stringify({ error: "短码只能包含字母、数字、- 和 _" }), {
          status: 400,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }

      // 检查是否重复
      if (await env.url.get(shortCode)) {
        return new Response(JSON.stringify({ error: "短码已存在，请换一个" }), {
          status: 400,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }

      await putRecord(shortCode, { url: longUrl, clicks: 0, maxClicks: parsedMaxClicks });

      return new Response(
        JSON.stringify({ shortUrl: `${new URL(request.url).origin}/${shortCode}`, code: shortCode, maxClicks: parsedMaxClicks }),
        { headers: { "Content-Type": "application/json", ...corsHeaders } }
      );
    }

    // ── GET /admin/list：列出所有短链（需鉴权）──────────────
    if (request.method === "GET" && pathname === "/admin/list") {
      if (!checkAuth()) return authFail();

      const list = await env.url.list();
      const items = await Promise.all(
        list.keys.map(async (k) => {
          const rec = await getRecord(k.name);
          return { code: k.name, url: rec.url, clicks: rec.clicks, maxClicks: rec.maxClicks };
        })
      );

      return new Response(JSON.stringify({ items, total: items.length }), {
        headers: { "Content-Type": "application/json", ...corsHeaders },
      });
    }

    // ── POST /admin/delete：批量删除（需鉴权）───────────────
    if (request.method === "POST" && pathname === "/admin/delete") {
      if (!checkAuth()) return authFail();

      const { codes } = await request.json();
      if (!Array.isArray(codes) || codes.length === 0) {
        return new Response(JSON.stringify({ error: "codes 不能为空" }), {
          status: 400,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }

      await Promise.all(codes.map((code) => env.url.delete(code)));

      return new Response(JSON.stringify({ ok: true, deleted: codes.length }), {
        headers: { "Content-Type": "application/json", ...corsHeaders },
      });
    }

    // ── POST /admin/update：修改目标网址 / 最大访问次数（需鉴权）───
    if (request.method === "POST" && pathname === "/admin/update") {
      if (!checkAuth()) return authFail();

      const { code, newUrl, maxClicks } = await request.json();
      if (!code || !newUrl || !/^https?:\/\//.test(newUrl)) {
        return new Response(JSON.stringify({ error: "参数错误" }), {
          status: 400,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }

      let parsedMaxClicks = null;
      if (maxClicks !== undefined && maxClicks !== null && maxClicks !== "") {
        const n = Number(maxClicks);
        if (!Number.isInteger(n) || n <= 0) {
          return new Response(JSON.stringify({ error: "最大访问次数必须是大于 0 的整数" }), {
            status: 400,
            headers: { "Content-Type": "application/json", ...corsHeaders },
          });
        }
        parsedMaxClicks = n;
      }

      // 修改网址/限制次数时保留原有的点击次数，不归零
      const old = await getRecord(code);
      await putRecord(code, { url: newUrl, clicks: old ? old.clicks : 0, maxClicks: parsedMaxClicks });

      return new Response(JSON.stringify({ ok: true }), {
        headers: { "Content-Type": "application/json", ...corsHeaders },
      });
    }

    // ── POST /admin/reset-clicks：清零某个短码的访问次数（需鉴权）──
    if (request.method === "POST" && pathname === "/admin/reset-clicks") {
      if (!checkAuth()) return authFail();

      const { code } = await request.json();
      const rec = await getRecord(code);
      if (!rec) {
        return new Response(JSON.stringify({ error: "短码不存在" }), {
          status: 404,
          headers: { "Content-Type": "application/json", ...corsHeaders },
        });
      }
      await putRecord(code, { url: rec.url, clicks: 0, maxClicks: rec.maxClicks });

      return new Response(JSON.stringify({ ok: true }), {
        headers: { "Content-Type": "application/json", ...corsHeaders },
      });
    }

    // ── 短链跳转 ─────────────────────────────────────────────
    if (pathname !== "/" && pathname !== "/admin") {
      const code = pathname.slice(1);
      const rec = await getRecord(code);
      if (rec) {
        const newClicks = rec.clicks + 1;
        if (rec.maxClicks && newClicks >= rec.maxClicks) {
          // 达到访问上限：本次仍然正常跳转，但随后异步删除该短链
          ctx.waitUntil(env.url.delete(code));
        } else {
          // 点击数 +1，用 waitUntil 异步写回，不阻塞跳转响应速度
          ctx.waitUntil(putRecord(code, { url: rec.url, clicks: newClicks, maxClicks: rec.maxClicks }));
        }
        return Response.redirect(rec.url, 302);
      }
      return new Response("短链不存在", { status: 404 });
    }

    // ── 前端页面 ─────────────────────────────────────────────
    return new Response(HTML, {
      headers: { "Content-Type": "text/html;charset=UTF-8" },
    });
  },
};

