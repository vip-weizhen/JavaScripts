    <input type="text" id="customInput" placeholder="留空则自动生成，仅限字母数字 - _" />
    <label>最大访问次数（可选）</label>
    <input type="number" id="maxClicksInput" placeholder="留空表示不限次数" min="1" step="1" />
    <p class="hint">达到该次数后，短链会在最后一次跳转完成后自动失效并删除</p>
    <button class="btn" onclick="shortenUrl()">生成短链 →</button>

    <div class="ticket" id="resultBox">
      <div class="ticket-barcode"></div>
      <div class="ticket-body">
        <div class="ticket-label">✅ 调度单已生成</div>
        <div class="ticket-row">
          <span id="shortUrlText"></span>
          <button class="copy-btn" onclick="copyUrl()">复制</button>
        </div>
        <p class="ticket-note" id="maxClicksNote"></p>
      </div>
    </div>
  </div>

  <!-- 管理后台 -->
  <div class="panel" id="panel-manage">
    <!-- 登录框 -->
    <div id="loginBox" class="admin-login">
      <h1>管理后台</h1>
      <label>管理密钥（ADMIN_TOKEN）</label>
      <input type="password" id="tokenInput" placeholder="输入你在 Worker 里设置的 token" />
      <button class="btn" onclick="doLogin()">登录</button>
    </div>

    <!-- 列表 -->
    <div id="listBox" style="display:none;">
      <div class="toolbar">
        <input type="text" id="searchInput" placeholder="搜索短码或网址…" oninput="filterTable()" />
        <button class="sort-btn" id="sortBtn" onclick="toggleSort()">按访问量排序</button>
        <span class="select-info" id="selectInfo"></span>
        <button class="del-selected-btn" id="batchDelBtn" disabled onclick="batchDelete()">删除所选</button>
      </div>
      <p class="total-tip" id="totalTip"></p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:32px"><input type="checkbox" id="checkAll" onchange="toggleAll(this)" /></th>
              <th>短码</th>
              <th>目标网址</th>
              <th style="width:84px">访问次数</th>
              <th style="width:150px">操作</th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
      <button class="btn btn-ghost" style="margin-top:14px;" onclick="doLogout()">退出登录</button>
    </div>
  </div>
</div>

<script>
  // ── Tab 切换 ──────────────────────────────────────────────
  function switchTab(name, el) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('panel-' + name).classList.add('active');
  }

  // ── 生成短链 ─────────────────────────────────────────────
  async function shortenUrl() {
    const url = document.getElementById('urlInput').value.trim();
    const customCode = document.getElementById('customInput').value.trim();
    const maxClicksRaw = document.getElementById('maxClicksInput').value.trim();
    if (!url) return alert('请输入网址');
    if (maxClicksRaw && (!/^\\d+$/.test(maxClicksRaw) || Number(maxClicksRaw) <= 0)) {
      return alert('最大访问次数必须是大于 0 的整数');
    }
    const res = await fetch('/shorten', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, customCode, maxClicks: maxClicksRaw ? Number(maxClicksRaw) : null })
    });
    const data = await res.json();
    if (data.error) {
      alert(data.error);
    } else {
      document.getElementById('shortUrlText').textContent = data.shortUrl;
      document.getElementById('maxClicksNote').textContent = data.maxClicks
        ? \`⏳ 最多可访问 \${data.maxClicks} 次，超过后自动失效并删除\`
        : '♾ 不限访问次数';
      document.getElementById('resultBox').style.display = 'block';
    }
  }

  function copyUrl() {
    const text = document.getElementById('shortUrlText').textContent;
    navigator.clipboard.writeText(text).then(() => alert('已复制到剪贴板！'));
  }

  // ── 管理后台 ─────────────────────────────────────────────
  let token = sessionStorage.getItem('admin_token') || '';
  let allRecords = [];
  let selected = new Set();
  let editingCode = null;
  let sortByClicks = false; // false: 默认顺序, true: 按访问量从高到低

  if (token) tryLoadList();

  function doLogin() {
    token = document.getElementById('tokenInput').value.trim();
    if (!token) return alert('请输入管理密钥');
    sessionStorage.setItem('admin_token', token);
    tryLoadList();
  }

  function doLogout() {
    token = '';
    sessionStorage.removeItem('admin_token');
    allRecords = [];
    selected.clear();
    document.getElementById('loginBox').style.display = '';
    document.getElementById('listBox').style.display = 'none';
  }

  async function tryLoadList() {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '<tr><td colspan="5" class="loading-tip">加载中…</td></tr>';
    document.getElementById('loginBox').style.display = 'none';
    document.getElementById('listBox').style.display = '';

    const res = await fetch('/admin/list', {
      headers: { 'Authorization': 'Bearer ' + token }
    });
    if (res.status === 401) {
      alert('密钥错误，请重新登录');
      doLogout();
      return;
    }
    const data = await res.json();
    allRecords = data.items || [];
    selected.clear();
    renderTable();
  }

  function filterTable() {
    selected.clear();
    renderTable();
  }

  function toggleSort() {
    sortByClicks = !sortByClicks;
    document.getElementById('sortBtn').classList.toggle('active', sortByClicks);
    renderTable();
  }

  function clicksClass(n) {
    if (n >= 100) return 'danger';
    if (n >= 20) return 'warn';
    return '';
  }

  function renderTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    let filtered = allRecords.filter(r =>
      r.code.toLowerCase().includes(q) || r.url.toLowerCase().includes(q)
    );
    if (sortByClicks) {
      filtered = [...filtered].sort((a, b) => (b.clicks || 0) - (a.clicks || 0));
    }
    document.getElementById('totalTip').textContent =
      \`共 \${allRecords.length} 条记录\${q ? '，筛选后 ' + filtered.length + ' 条' : ''}\`;

    const tbody = document.getElementById('tableBody');
    if (!filtered.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-tip">暂无记录</td></tr>';
      updateBatchBtn();
      return;
    }

    tbody.innerHTML = filtered.map(r => {
      const clicks = r.clicks || 0;
      const maxClicks = r.maxClicks || null;
      const maxPart = maxClicks ? \`<span class="max-part"> / \${maxClicks}</span>\` : '';
      const pillClass = clicksClass(clicks);
      const clicksDisplay = \`<span class="click-pill \${pillClass}">\${clicks}\${maxPart}</span>\`;
      if (r.code === editingCode) {
        return \`<tr>
          <td><input type="checkbox" class="row-check" value="\${r.code}" onchange="onCheck()" \${selected.has(r.code) ? 'checked' : ''} /></td>
          <td class="code-td">\${r.code}</td>
          <td colspan="3">
            <input class="edit-input" id="edit-input-\${r.code}" value="\${escHtml(r.url)}" placeholder="目标网址" />
            <input class="edit-input" id="edit-max-\${r.code}" value="\${maxClicks || ''}" placeholder="最大访问次数，留空不限" style="margin-top:6px;" />
            <div style="margin-top:6px;display:flex;gap:4px;">
              <button class="save-btn" onclick="saveEdit('\${r.code}')">保存</button>
              <button class="cancel-btn" onclick="cancelEdit()">取消</button>
            </div>
          </td>
        </tr>\`;
      }
      return \`<tr>
        <td><input type="checkbox" class="row-check" value="\${r.code}" onchange="onCheck()" \${selected.has(r.code) ? 'checked' : ''} /></td>
        <td class="code-td">\${r.code}</td>
        <td class="url-td" title="\${escHtml(r.url)}">\${escHtml(r.url)}</td>
        <td>\${clicksDisplay}</td>
        <td>
          <button class="row-edit-btn" onclick="startEdit('\${r.code}')">编辑</button>
          <button class="row-reset-btn" onclick="resetClicks('\${r.code}')">清零</button>
          <button class="row-del-btn" onclick="deleteOne('\${r.code}')">删除</button>
        </td>
      </tr>\`;
    }).join('');

    updateBatchBtn();
    document.getElementById('checkAll').checked = false;
  }

  function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function onCheck() {
    selected = new Set([...document.querySelectorAll('.row-check:checked')].map(c => c.value));
    updateBatchBtn();
  }

  function toggleAll(cb) {
    document.querySelectorAll('.row-check').forEach(c => { c.checked = cb.checked; });
    onCheck();
  }

  function updateBatchBtn() {
    const n = selected.size;
    document.getElementById('batchDelBtn').disabled = n === 0;
    document.getElementById('selectInfo').textContent = n ? \`已选 \${n} 条\` : '';
  }

  async function deleteOne(code) {
    if (!confirm(\`确认删除短码 "\${code}"？\`)) return;
    const res = await fetch('/admin/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ codes: [code] })
    });
    const data = await res.json();
    if (data.ok) {
      allRecords = allRecords.filter(r => r.code !== code);
      selected.delete(code);
      renderTable();
    } else {
      alert('删除失败：' + (data.error || '未知错误'));
    }
  }

  async function batchDelete() {
    const codes = [...selected];
    if (!confirm(\`确认删除选中的 \${codes.length} 条记录？\`)) return;
    const res = await fetch('/admin/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ codes })
    });
    const data = await res.json();
    if (data.ok) {
      allRecords = allRecords.filter(r => !selected.has(r.code));
      selected.clear();
      renderTable();
    } else {
      alert('删除失败：' + (data.error || '未知错误'));
    }
  }

  async function resetClicks(code) {
    if (!confirm(\`确认将短码 "\${code}" 的访问次数清零？\`)) return;
    const res = await fetch('/admin/reset-clicks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ code })
    });
    const data = await res.json();
    if (data.ok) {
      const rec = allRecords.find(r => r.code === code);
      if (rec) rec.clicks = 0;
      renderTable();
    } else {
      alert('清零失败：' + (data.error || '未知错误'));
    }
  }

  function startEdit(code) {
    editingCode = code;
    renderTable();
    document.getElementById('edit-input-' + code)?.focus();
  }

  function cancelEdit() {
    editingCode = null;
    renderTable();
  }

  async function saveEdit(code) {
    const newUrl = document.getElementById('edit-input-' + code)?.value.trim();
    const maxClicksRaw = document.getElementById('edit-max-' + code)?.value.trim();
    if (!newUrl || !/^https?:\\/\\//.test(newUrl)) {
      alert('请输入合法的网址');
      return;
    }
    if (maxClicksRaw && (!/^\\d+$/.test(maxClicksRaw) || Number(maxClicksRaw) <= 0)) {
      alert('最大访问次数必须是大于 0 的整数');
      return;
    }
    const maxClicks = maxClicksRaw ? Number(maxClicksRaw) : null;
    const res = await fetch('/admin/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ code, newUrl, maxClicks })
    });
    const data = await res.json();
    if (data.ok) {
      const rec = allRecords.find(r => r.code === code);
      if (rec) {
        rec.url = newUrl;
        rec.maxClicks = maxClicks;
      }
      editingCode = null;
      renderTable();
    } else {
      alert('保存失败：' + (data.error || '未知错误'));
    }
  }
</script>
</body>
</html>`;
