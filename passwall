/**
 * Cloudflare Worker：订阅分发（手动节点 + 自动优选IP节点） + 密码保护的管理页面
 *
 * 访问方式：
 *   GET /            -> 订阅内容（base64）= 手动节点 + 自动生成节点，客户端直接用这个地址订阅
 *   GET /admin        -> 管理页面（需要密码），可编辑手动节点、自动节点的模板/来源/数量
 *
 * 需要的资源：
 *   1. KV 命名空间，绑定变量名 SUB_KV
 *   2. Secret：ADMIN_PASSWORD
 */

const KV_KEY = 'sub_config';

// 首次部署、KV 还没有数据时的默认配置
const DEFAULT_CONFIG = {
  manual: ``,
  auto: {
    enabled: true,
    // 每个来源: { url, keyword, count }。keyword 为空字符串表示不过滤。
    sources: [
      { url: '', keyword: '', count: 5 },
    ],
    template:
      '',
  },
};

/* ---------------- 工具函数 ---------------- */

function toBase64Unicode(str) {
  const bytes = new TextEncoder().encode(str);
  let binary = '';
  bytes.forEach((b) => (binary += String.fromCharCode(b)));
  return btoa(binary);
}

function cors(resp) {
  resp.headers.set('Access-Control-Allow-Origin', '*');
  return resp;
}

function jsonResponse(obj, status = 200) {
  return cors(
    new Response(JSON.stringify(obj), {
      status,
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
    })
  );
}

function checkPassword(request, env) {
  const auth = request.headers.get('X-Admin-Password') || '';
  return auth === env.ADMIN_PASSWORD;
}

// 规范化一条 source 记录，兼容缺字段的情况
function normalizeSource(s) {
  return {
    url: typeof s?.url === 'string' ? s.url.trim() : '',
    keyword: typeof s?.keyword === 'string' ? s.keyword.trim() : '',
    count: Number.isFinite(s?.count) ? s.count : 5,
  };
}

function normalizeSources(rawSources, fallbackSourceUrl, fallbackCount) {
  if (Array.isArray(rawSources) && rawSources.length > 0) {
    return rawSources.map(normalizeSource).filter((s) => s.url);
  }
  // 兼容旧版单一 sourceUrl/count 字段
  if (fallbackSourceUrl) {
    return [normalizeSource({ url: fallbackSourceUrl, keyword: '', count: fallbackCount })];
  }
  return [];
}

async function getConfig(env) {
  const stored = await env.SUB_KV.get(KV_KEY, 'json');
  if (!stored) return structuredClone(DEFAULT_CONFIG);
  return {
    manual: typeof stored.manual === 'string' ? stored.manual : DEFAULT_CONFIG.manual,
    auto: {
      enabled: stored.auto?.enabled !== undefined ? !!stored.auto.enabled : DEFAULT_CONFIG.auto.enabled,
      sources: normalizeSources(stored.auto?.sources, stored.auto?.sourceUrl, stored.auto?.count),
      template: stored.auto?.template || DEFAULT_CONFIG.auto.template,
    },
  };
}

async function saveConfig(env, config) {
  await env.SUB_KV.put(KV_KEY, JSON.stringify(config));
}

// 解析 "host:PORT#备注" 格式的优选列表，host 既可以是 IPv4 也可以是域名
// keyword 非空时，只保留 host 或备注中包含该关键字的行（大小写不敏感）
// 返回按 limit 截取后的 [{host, port, note}]
function parseIpList(text, keyword, limit) {
  const results = [];
  const lines = text.split('\n');
  // host 部分允许字母、数字、点、短横线（覆盖 IPv4 和域名两种情况），必须跟着 :端口 和 #
  const lineRe = /^([a-zA-Z0-9.-]+):(\d{1,5})\s*#\s*(.*)$/;
  const kw = (keyword || '').toLowerCase();
  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line) continue;
    const m = line.match(lineRe);
    if (!m) continue;
    const ip = m[1];
    const port = m[2];
    const note = m[3].trim();
    if (kw && !ip.toLowerCase().includes(kw) && !note.toLowerCase().includes(kw)) continue;
    results.push({ ip, port, note });
    if (results.length >= limit) break;
  }
  return results;
}

// 把模板节点里的 host:port 换成给定 IP:port，remark 加上标记，其余参数不变
// label: 用于替代默认的"自动"标记，例如来源配置了关键字，就用关键字作为标签（如"电信1"），未配置则用"自动1"
function buildNodeFromTemplate(template, ip, port, idx, note, label) {
  // 通用格式: scheme://userinfo@host:port?query#fragment
  const m = template.match(/^([a-zA-Z0-9-]+):\/\/([^@]+)@([^:/?#]+):(\d+)([^#]*)(#.*)?$/);
  if (!m) return null;
  const [, scheme, userinfo, , , queryPart, fragmentPart] = m;

  const tag = (label && label.trim()) ? label.trim() : '自动';

  let remark = `Mr.wei ${tag} ${idx}`;
  if (fragmentPart) {
    try {
      remark = decodeURIComponent(fragmentPart.slice(1));
    } catch (e) {
      remark = fragmentPart.slice(1);
    }
    remark = `${remark}-${tag}${idx}`;
  }
  const speedMatch = note.match(/([\d.]+\s*MB\/s)/i);
  if (speedMatch) remark += ` ${speedMatch[1]}`;

  return `${scheme}://${userinfo}@${ip}:${port}${queryPart}#${encodeURIComponent(remark)}`;
}

// 抓取单个来源，返回过滤截取后的 {ip, port, note} 列表
async function fetchOneSource(source) {
  if (!source.url) return [];
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 6000);
    const res = await fetch(source.url, {
      signal: controller.signal,
      cf: { cacheTtl: 300, cacheEverything: true }, // Cloudflare 边缘缓存 5 分钟，减轻抓取压力
    });
    clearTimeout(timeout);
    if (!res.ok) return [];
    const text = await res.text();
    const count = Math.max(1, Math.min(50, source.count || 5));
    return parseIpList(text, source.keyword, count);
  } catch (e) {
    // 单个来源抓取失败时静默忽略，不影响其他来源和手动节点
    return [];
  }
}

async function fetchAutoNodes(autoCfg) {
  if (!autoCfg.enabled || !autoCfg.template) return [];
  const sources = autoCfg.sources || [];
  if (sources.length === 0) return [];

  const perSourceResults = await Promise.all(sources.map(fetchOneSource));

  // 按 host:port 去重（不同来源可能抓到同一个 IP）；每个来源单独计数，方便备注显示"关键字+序号"
  const seen = new Set();
  const nodes = [];
  perSourceResults.forEach((items, si) => {
    const label = sources[si]?.keyword || '';
    let idx = 0;
    for (const item of items) {
      const key = `${item.ip}:${item.port}`;
      if (seen.has(key)) continue;
      seen.add(key);
      idx += 1;
      const node = buildNodeFromTemplate(autoCfg.template, item.ip, item.port, idx, item.note, label);
      if (node) nodes.push(node);
    }
  });
  return nodes;
}

async function buildSubscriptionContent(env) {
  const config = await getConfig(env);
  const manualLines = config.manual.trim();
  const autoNodes = await fetchAutoNodes(config.auto);
  const parts = [manualLines];
  if (autoNodes.length > 0) parts.push(autoNodes.join('\n'));
  return parts.filter(Boolean).join('\n') + '\n';
}

