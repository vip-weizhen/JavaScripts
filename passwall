<body>
<div class="wrap">
  <h1>订阅节点管理</h1>
  <p class="sub">订阅地址本身不受影响，客户端照常直接访问根地址订阅。保存后立即生效，无需重新部署。</p>

  <div class="card" id="loginCard">
    <label for="pwd">管理密码</label>
    <input type="password" id="pwd" placeholder="输入密码" autocomplete="current-password" />
    <div class="row">
      <button id="loginBtn">进入</button>
    </div>
    <div class="status" id="loginStatus"></div>
  </div>

  <div class="hidden" id="editArea">
    <div class="card">
      <h2>手动节点（每行一个 vless:// 或 trojan:// 链接）</h2>
      <textarea id="manual" spellcheck="false"></textarea>
      <div class="count" id="manualCount"></div>
    </div>

    <div class="card">
      <h2>自动优选节点</h2>
      <div class="switch-row">
        <input type="checkbox" id="autoEnabled" />
        <label for="autoEnabled" style="margin:0;">启用自动节点（从下方来源抓取优选 IP，替换进模板节点后追加到订阅）</label>
      </div>

      <label style="margin-top:18px;">优选 IP 来源（可添加多个，每个来源可单独设置关键字筛选和取前几个）</label>
      <div id="sourcesList"></div>
      <button class="secondary add-source-btn" id="addSourceBtn" type="button">+ 添加来源</button>

      <label for="template" style="margin-top:20px;">模板节点（自动抓到的 IP:端口 会替换掉这个节点里的地址和端口，其余参数不变）</label>
      <textarea class="small" id="template" spellcheck="false"></textarea>
    </div>

    <div class="row">
      <button id="saveBtn">保存并生效</button>
      <button class="secondary" id="reloadBtn">重新加载当前内容</button>
      <button class="secondary" id="logoutBtn">退出</button>
    </div>
    <div class="status" id="saveStatus"></div>
  </div>
</div>

<script>
let pwd = '';

const loginCard = document.getElementById('loginCard');
const editArea = document.getElementById('editArea');
const pwdInput = document.getElementById('pwd');
const loginBtn = document.getElementById('loginBtn');
const loginStatus = document.getElementById('loginStatus');
const manualArea = document.getElementById('manual');
const manualCount = document.getElementById('manualCount');
const autoEnabled = document.getElementById('autoEnabled');
const sourcesList = document.getElementById('sourcesList');
const addSourceBtn = document.getElementById('addSourceBtn');
const templateArea = document.getElementById('template');
const saveBtn = document.getElementById('saveBtn');
const reloadBtn = document.getElementById('reloadBtn');
const logoutBtn = document.getElementById('logoutBtn');
const saveStatus = document.getElementById('saveStatus');

function setStatus(el, msg, type) {
  el.textContent = msg;
  el.className = 'status' + (type ? ' ' + type : '');
}

function updateManualCount() {
  const n = manualArea.value.split('\\n').filter(l => l.trim().length > 0).length;
  manualCount.textContent = n + ' 个手动节点';
}

function renumberSourceRows() {
  const rows = sourcesList.querySelectorAll('.source-row');
  rows.forEach((row, i) => {
    row.querySelector('.source-row-head span').textContent = '来源 ' + (i + 1);
    row.querySelector('.remove-source-btn').disabled = rows.length <= 1;
  });
}

function addSourceRow(data) {
  data = data || { url: '', keyword: '', count: 5 };
  const row = document.createElement('div');
  row.className = 'source-row';
  row.innerHTML =
    '<div class="source-row-head"><span></span><button type="button" class="danger remove-source-btn">删除</button></div>' +
    '<label style="margin-top:6px;">来源地址（格式：IP:端口#备注，一行一个）</label>' +
    '<input type="text" class="src-url" placeholder="https://..." />' +
    '<div class="source-fields-inline" style="margin-top:10px;">' +
      '<div><label style="margin-top:0;">关键字筛选（留空则不筛选，匹配 IP/域名或备注）</label><input type="text" class="src-keyword" placeholder="例如：香港 / HK / 日本" /></div>' +
      '<div><label style="margin-top:0;">取前几个</label><input type="number" class="src-count" min="1" max="50" /></div>' +
    '</div>';
  row.querySelector('.src-url').value = data.url || '';
  row.querySelector('.src-keyword').value = data.keyword || '';
  row.querySelector('.src-count').value = data.count || 5;
  row.querySelector('.remove-source-btn').addEventListener('click', () => {
    if (sourcesList.querySelectorAll('.source-row').length <= 1) return;
    row.remove();
    renumberSourceRows();
  });
  sourcesList.appendChild(row);
  renumberSourceRows();
}

function setSourceRows(sources) {
  sourcesList.innerHTML = '';
  if (!sources || sources.length === 0) {
    addSourceRow();
  } else {
    sources.forEach(s => addSourceRow(s));
  }
}

function collectSourceRows() {
  return Array.from(sourcesList.querySelectorAll('.source-row')).map(row => ({
    url: row.querySelector('.src-url').value.trim(),
    keyword: row.querySelector('.src-keyword').value.trim(),
    count: parseInt(row.querySelector('.src-count').value, 10) || 5,
  })).filter(s => s.url);
}

addSourceBtn.addEventListener('click', () => addSourceRow());

async function loadContent() {
  const res = await fetch('/admin/api/get', {
    method: 'POST',
    headers: { 'X-Admin-Password': pwd, 'Content-Type': 'application/json' },
  });
  if (!res.ok) throw new Error('unauthorized');
  const data = await res.json();
  manualArea.value = data.manual;
  autoEnabled.checked = !!data.auto.enabled;
  setSourceRows(data.auto.sources);
  templateArea.value = data.auto.template;
  updateManualCount();
}

async function tryLogin() {
  pwd = pwdInput.value;
  if (!pwd) { setStatus(loginStatus, '请输入密码', 'err'); return; }
  loginBtn.disabled = true;
  setStatus(loginStatus, '验证中...', '');
  try {
    await loadContent();
    loginCard.classList.add('hidden');
    editArea.classList.remove('hidden');
    setStatus(loginStatus, '', '');
  } catch (e) {
    setStatus(loginStatus, '密码错误', 'err');
  } finally {
    loginBtn.disabled = false;
  }
}

loginBtn.addEventListener('click', tryLogin);
pwdInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryLogin(); });
manualArea.addEventListener('input', updateManualCount);

saveBtn.addEventListener('click', async () => {
  saveBtn.disabled = true;
  setStatus(saveStatus, '保存中...', '');
  try {
    const res = await fetch('/admin/api/set', {
      method: 'POST',
      headers: { 'X-Admin-Password': pwd, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        manual: manualArea.value,
        auto: {
          enabled: autoEnabled.checked,
          sources: collectSourceRows(),
          template: templateArea.value.trim(),
        },
      }),
    });
    if (!res.ok) throw new Error('failed');
    setStatus(saveStatus, '已保存，订阅地址已更新 ✓', 'ok');
  } catch (e) {
    setStatus(saveStatus, '保存失败，请重试', 'err');
  } finally {
    saveBtn.disabled = false;
  }
});

reloadBtn.addEventListener('click', async () => {
  try {
    await loadContent();
    setStatus(saveStatus, '已重新加载', 'ok');
  } catch (e) {
    setStatus(saveStatus, '加载失败', 'err');
  }
});

logoutBtn.addEventListener('click', () => {
  pwd = '';
  pwdInput.value = '';
  manualArea.value = '';
  editArea.classList.add('hidden');
  loginCard.classList.remove('hidden');
  setStatus(loginStatus, '', '');
  setStatus(saveStatus, '', '');
});
</script>
</body>
</html>`;
}

/* ---------------- 入口 ---------------- */

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (path === '/admin' || path === '/admin/') {
      return new Response(adminPageHtml(), {
        headers: { 'Content-Type': 'text/html; charset=utf-8' },
      });
    }

    if (path === '/admin/api/get' && request.method === 'POST') {
      if (!checkPassword(request, env)) return jsonResponse({ error: 'unauthorized' }, 401);
      const config = await getConfig(env);
      return jsonResponse(config);
    }

    if (path === '/admin/api/set' && request.method === 'POST') {
      if (!checkPassword(request, env)) return jsonResponse({ error: 'unauthorized' }, 401);
      let body;
      try {
        body = await request.json();
      } catch (e) {
        return jsonResponse({ error: 'invalid body' }, 400);
      }
      const config = {
        manual: (body.manual || '').trim() + '\n',
        auto: {
          enabled: !!body.auto?.enabled,
          sources: normalizeSources(body.auto?.sources, body.auto?.sourceUrl, body.auto?.count),
          template: body.auto?.template || '',
        },
      };
      await saveConfig(env, config);
      return jsonResponse({ ok: true });
    }

    // 默认：订阅内容 = 手动节点 + 自动生成节点
    const content = await buildSubscriptionContent(env);
    return new Response(toBase64Unicode(content), {
      headers: {
        'Content-Type': 'text/plain; charset=utf-8',
        'Cache-Control': 'no-store',
      },
    });
  },
};
