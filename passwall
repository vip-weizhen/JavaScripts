  label:first-child { margin-top: 0; }
  input[type="password"], input[type="text"], input[type="number"], textarea {
    width: 100%;
    background: #fafbfc;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
  }
  textarea {
    min-height: 260px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12.5px;
    line-height: 1.5;
    resize: vertical;
    white-space: pre;
  }
  textarea.small { min-height: 70px; white-space: pre-wrap; word-break: break-all; }
  .inline { display: flex; gap: 10px; align-items: center; }
  .inline input[type="number"] { width: 100px; }
  .switch-row { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
  .switch-row input { width: auto; }
  button {
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  button:hover { background: var(--accent-hover); }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  button.secondary { background: #fff; border: 1px solid var(--border); color: var(--text); }
  button.secondary:hover { background: #f2f3f5; }
